---

---

<section
    id="contact-container"
    class="bg-[var(--color-harvest-gold)] py-20 text-[var(--color-paper-cream)]"
>
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl mb-6 text-[var(--color-paper-cream)]">
            Holler at Us
        </h2>
        <p class="text-xl mb-12 font-light">
            Have a question or something to sell? Drop us a line.
        </p>

        <form
            class="max-w-2xl mx-auto space-y-6 text-left"
            action="mailto:info@roostersantiquemarket.com"
            method="post"
            enctype="text/plain"
        >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label
                        for="name"
                        class="block text-sm font-bold mb-2 uppercase tracking-wide"
                        >Name</label
                    >
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="w-full bg-[var(--color-paper-cream)] text-[var(--color-denim-slate)] border-0 rounded p-4 focus:ring-2 focus:ring-[var(--color-rooster-rust)] outline-none"
                        placeholder="Your Name"
                        required
                    />
                </div>
                <div>
                    <label
                        for="email"
                        class="block text-sm font-bold mb-2 uppercase tracking-wide"
                        >Email</label
                    >
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="w-full bg-[var(--color-paper-cream)] text-[var(--color-denim-slate)] border-0 rounded p-4 focus:ring-2 focus:ring-[var(--color-rooster-rust)] outline-none"
                        placeholder="Your Email"
                        required
                    />
                </div>
            </div>

            <div>
                <label
                    for="message"
                    class="block text-sm font-bold mb-2 uppercase tracking-wide"
                    >Message</label
                >
                <textarea
                    id="message"
                    name="message"
                    rows="5"
                    class="w-full bg-[var(--color-paper-cream)] text-[var(--color-denim-slate)] border-0 rounded p-4 focus:ring-2 focus:ring-[var(--color-rooster-rust)] outline-none"
                    placeholder="What's on your mind?"
                    required></textarea>
            </div>

            <div class="text-center">
                <button
                    type="submit"
                    class="bg-[var(--color-rooster-rust)] text-[var(--color-paper-cream)] px-12 py-4 rounded-full font-bold text-lg uppercase tracking-widest hover:bg-[var(--color-verdigris)] transition-colors duration-300 shadow-lg transform hover:scale-105"
                >
                    Send Message
                </button>
            </div>
        </form>
    </div>
</section>
