---
const logoUrl = "/assets/rooster-framed.webp";

const linksLeft = [
    { name: "Our Treasures", href: "#treasures-container" },
    { name: "Our Community", href: "#community-container" },
    { name: "Our Story", href: "#story-container" },
];

const linksRight = [
    { name: "Events", href: "#events-container" },
    { name: "Find Us", href: "#findus-container" },
    { name: "Holler at Us", href: "#contact-container" },
];

const allLinks = [...linksLeft, ...linksRight];
---

<nav
    id="nav-bar-container"
    class="bg-[var(--color-paper-cream)] py-4 sticky top-0 z-50 shadow-md"
>
    <div
        class="container mx-auto flex justify-between md:justify-center items-center px-4 font-bold text-[var(--color-denim-slate)] relative"
    >
        <!-- Desktop Links Left -->
        <div class="hidden md:flex space-x-8 items-center">
            {
                linksLeft.map((link) => (
                    <a
                        href={link.href}
                        class="hover:text-[var(--color-rooster-rust)] transition-colors duration-300 uppercase tracking-wide text-sm"
                    >
                        {link.name}
                    </a>
                ))
            }
        </div>

        <!-- Central Logo -->
        <div class="md:mx-8">
            <img
                src={logoUrl}
                alt="Rooster's Antiquity Market Logo"
                class="h-16 md:h-20 w-auto object-contain hover:scale-105 transition-transform duration-300"
            />
        </div>

        <!-- Desktop Links Right -->
        <div class="hidden md:flex space-x-8 items-center">
            {
                linksRight.map((link) => (
                    <a
                        href={link.href}
                        class="hover:text-[var(--color-rooster-rust)] transition-colors duration-300 uppercase tracking-wide text-sm"
                    >
                        {link.name}
                    </a>
                ))
            }
        </div>

        <!-- Mobile Hamburger Button -->
        <button
            id="mobile-menu-btn"
            class="md:hidden p-2 text-[var(--color-denim-slate)] hover:text-[var(--color-rooster-rust)] focus:outline-none transition-colors"
            aria-label="Toggle Menu"
        >
            <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </div>

    <!-- Mobile Menu Overlay -->
    <div
        id="mobile-menu"
        class="hidden absolute top-full left-0 w-full bg-[var(--color-paper-cream)] shadow-xl flex-col items-center py-6 space-y-4 md:hidden border-t border-[var(--color-rooster-rust)]/20"
    >
        {
            allLinks.map((link) => (
                <a
                    href={link.href}
                    class="mobile-link text-lg text-[var(--color-denim-slate)] hover:text-[var(--color-rooster-rust)] font-bold transition-colors duration-300 uppercase tracking-wide"
                >
                    {link.name}
                </a>
            ))
        }
    </div>
</nav>

<script>
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener("click", () => {
            mobileMenu.classList.toggle("hidden");
            mobileMenu.classList.toggle("flex");
        });

        // Close menu when a link is clicked
        mobileLinks.forEach((link) => {
            link.addEventListener("click", () => {
                mobileMenu.classList.add("hidden");
                mobileMenu.classList.remove("flex");
            });
        });
    }
</script>
