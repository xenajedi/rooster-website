---
const cards = [
  { 
    title: "Experience unique rooms", 
    borderColor: "var(--color-rooster-rust)",
    img: "./src/assets/rooster-actual-room-1.webp",
    desc: "Wander through our themed rooms, each telling a different story of the past."
  },
  { 
    title: "Vendor Spotlight", 
    borderColor: "var(--color-verdigris)",
    img: "./src/assets/rooster-actual-room-2.webp",
    desc: "Meet the passionate collectors and curators who make our market special."
  },
  { 
    title: "Celebrate Cajun Culture", 
    borderColor: "var(--color-harvest-gold)",
    img: "./src/assets/rooster-actual-room-3.webp",
    desc: "Immerse yourself in the rich heritage and traditions of Louisiana."
  }
];
---

<section id="community-container" class="bg-[var(--color-paper-cream)] py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl md:text-5xl text-center mb-16 text-[var(--color-denim-slate)]">Our Community</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {cards.map((card, index) => (
        <div class="group relative h-[420px] rounded-xl transition-all duration-500 shadow-xl hover:shadow-2xl cursor-pointer">
          <!-- Glow effect background (shows on hover) -->
          <div class="absolute inset-0 rounded-xl opacity-0 group-hover:opacity-40 transition-opacity duration-700 pointer-events-none z-0" style={`box-shadow: 0 0 25px 5px ${card.borderColor};`}></div>
          
          <!-- Inner Card -->
          <div class="relative w-full h-full bg-white rounded-xl overflow-hidden flex flex-col z-10" style={`border-bottom: 4px solid ${card.borderColor};`}>
            
            <!-- Image with scale on hover -->
            <div class="h-1/2 w-full overflow-hidden bg-gray-100">
              <img src={card.img} alt={card.title} class="w-full h-full object-cover transform transition-transform duration-700 ease-out group-hover:scale-110" loading="lazy" />
            </div>

            <!-- Content -->
            <div class="h-1/2 flex flex-col items-center justify-center p-6 text-center bg-white z-20">
              <h3 class="text-2xl font-bold text-[var(--color-denim-slate)] font-serif mb-3">{card.title}</h3>
              <p class="text-base leading-relaxed font-light text-gray-700">{card.desc}</p>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>
