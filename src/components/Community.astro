---
const cards = [
  { 
    title: "Experience unique rooms", 
    borderColor: "var(--color-rooster-rust)",
    img: "https://via.placeholder.com/400x300/A64B42/F4F0E6?text=Unique+Rooms",
    desc: "Wander through our themed rooms, each telling a different story of the past."
  },
  { 
    title: "Vendor Spotlight", 
    borderColor: "var(--color-verdigris)",
    img: "https://via.placeholder.com/400x300/60857A/F4F0E6?text=Vendor+Spotlight",
    desc: "Meet the passionate collectors and curators who make our market special."
  },
  { 
    title: "Celebrate Cajun Culture", 
    borderColor: "var(--color-harvest-gold)",
    img: "https://via.placeholder.com/400x300/D4A259/F4F0E6?text=Cajun+Culture",
    desc: "Immerse yourself in the rich heritage and traditions of Louisiana."
  }
];
---

<section id="community-container" class="bg-[var(--color-paper-cream)] py-20">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl md:text-5xl text-center mb-16 text-[var(--color-denim-slate)]">Our Community</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {cards.map((card, index) => (
        <div class="group relative perspective-1000 h-96 cursor-pointer">
          <div class="relative w-full h-full transform transition-transform duration-700 preserve-3d group-hover:rotate-y-180 shadow-xl rounded-lg overflow-hidden" style={`border-bottom: 4px solid ${card.borderColor};`}>
            
            <!-- Front of Card -->
            <div class="absolute inset-0 backface-hidden bg-white">
              <img src={card.img} alt={card.title} class="w-full h-2/3 object-cover" loading="lazy" />
              <div class="h-1/3 flex items-center justify-center p-4">
                <h3 class="text-2xl text-center font-bold text-[var(--color-denim-slate)] font-serif">{card.title}</h3>
              </div>
            </div>

            <!-- Back of Card (Rotated) -->
            <div class="absolute inset-0 backface-hidden rotate-y-180 bg-[var(--color-denim-slate)] text-[var(--color-paper-cream)] flex flex-col items-center justify-center p-8 text-center" style={`border: 2px solid ${card.borderColor}`}>
              <h3 class="text-2xl mb-4 font-bold font-serif" style={`color: ${card.borderColor}`}>{card.title}</h3>
              <p class="text-lg leading-relaxed font-light">{card.desc}</p>
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .preserve-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
</style>
