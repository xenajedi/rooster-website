---
const logoUrl = "/assets/rooster-sign-font.png";
---

<footer
    class="bg-[var(--color-denim-slate)] text-[var(--color-paper-cream)] py-12 border-t-8 border-[var(--color-rooster-rust)]"
>
    <div class="container mx-auto px-4 flex flex-col items-center">
        <div class="mb-6">
            <img
                src={logoUrl}
                alt="Rooster's Logo Footer"
                class="h-24 w-auto opacity-90 hover:opacity-100 transition-opacity duration-300"
            />
        </div>

        <div class="text-center font-light text-sm opacity-75">
            <p>&copy; 2026 Roosters Antiques & Home Decor</p>
            <p class="mt-2 text-[var(--color-harvest-gold)]">
                Website designed by BLC Media & Design
            </p>
        </div>
    </div>
</footer>
